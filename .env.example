# Client-side (safe to expose — must be prefixed EXPO_PUBLIC_ to reach the app bundle)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Only needed if the Expo Router API routes (app/api/**) aren't served from the
# same origin the app is running from — e.g. a native dev build pointed at a
# deployed API. Leave unset for local dev and web.
# EXPO_PUBLIC_API_URL=https://your-deployed-app.example.com

# Optional — raises Google Books' per-IP rate limit (keyless calls 429 quickly).
# Search still works without it, just more prone to throttling.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Optional — Google AdSense (web build only, see components/AdBanner.tsx).
# Requires an approved AdSense account for this site's domain. Leave unset
# and the feed simply renders with no ad slots (no test/placeholder ads
# exist for AdSense the way they do for AdMob).
# EXPO_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# EXPO_PUBLIC_ADSENSE_SLOT_ID=xxxxxxxxxx

# Server-only (used by app/api/push/send+api.ts — never prefix this with EXPO_PUBLIC_)
# Bypasses Row-Level Security entirely — keep this out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — free personal token from https://hardcover.app/account/api
# (requires a Hardcover account). Powers app/api/hardcover-lookup+api.ts
# (ISBN cover/description/genres/tropes/series lookup) and
# app/api/hardcover-search+api.ts / hardcover-trending+api.ts (primary
# source for search/trending/popular/recommendations — see lib/hardcover.ts,
# falls back to Open Library/Google Books/BnF automatically if unset or a
# request fails). Server-only: Hardcover's API blocks the browser's CORS
# preflight, so these routes proxy it rather than calling it from the client.
# Requires web.output: "server" in app.json — API routes don't run at all
# with the "single" static-export mode.
HARDCOVER_API_TOKEN=your-hardcover-api-token

# e2e/ (Playwright) — a real, non-admin test account. Never used by the app
# itself, only by the test suite (npm run test:e2e).
E2E_EMAIL=test-account@example.com
E2E_PASSWORD=your-test-password
